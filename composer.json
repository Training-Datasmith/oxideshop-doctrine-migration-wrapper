{
    "name": "oxid-esales/oxideshop-doctrine-migration-wrapper",
    "description": "OXID eShop database migrations using Doctrine",
    "license": "proprietary",
    "require": {
        "doctrine/migrations": "^3.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Oxid_Esales\\Doctrine_Migration_Wrapper\\": "./src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Oxid_Esales\\Doctrine_Migration_Wrapper\\Tests\\": "./tests"
        }
    },
    "bin": [
        "./bin/oe-eshop-db_migrate",
        "./bin/oe-eshop-doctrine_migration"
    ]
}

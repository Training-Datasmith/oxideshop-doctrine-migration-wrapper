{
    "name": "oxid-esales/oxideshop-doctrine-migration-wrapper",
    "description": "OXID eShop database migrations using Doctrine",
    "license": "proprietary",
    "require": {
        "doctrine/migrations": "^3.0"
    },
    "require-dev": {
        "mikey179/vfsstream": "1.6.12",
        "phpspec/prophecy-phpunit": "2.1.0",
        "phpunit/phpunit": "^10.5.62",
        "symfony/filesystem": "6.4.45",
        "symfony/yaml": "6.4.47"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.1.99"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "OxidEsales\\DoctrineMigrationWrapper\\": "./src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OxidEsales\\DoctrineMigrationWrapper\\Tests\\": "./tests",
            "OxidEsales\\DoctrineMigrationWrapper\\Suite\\": "./suite",
            "OxidEsales\\EshopCommunity\\": "./suite/standin/EshopCommunity"
        }
    },
    "bin": [
        "./bin/oe-eshop-db_migrate",
        "./bin/oe-eshop-doctrine_migration"
    ]
}
